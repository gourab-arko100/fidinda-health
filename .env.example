# Copy this file to .env.local (for your computer) and add the same two values in
# Vercel → Project → Settings → Environment Variables (for the live site).
# Never commit .env.local or share the token publicly.

# Token from @BotFather, e.g. 7412345678:AAH...
TELEGRAM_BOT_TOKEN=

# Telegram chat that receives enquiries: your account's ID (e.g. 123456789)
# or a group's ID (starts with -100...)
TELEGRAM_CHAT_ID=
